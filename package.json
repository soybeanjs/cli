{
  "name": "@soybeanjs/cli",
  "version": "1.8.1",
  "description": "SoybeanJS's command line tools",
  "homepage": "https://github.com/soybeanjs/cli",
  "bugs": {
    "url": "https://github.com/soybeanjs/cli/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "repository": {
    "url": "https://github.com/soybeanjs/cli.git"
  },
  "bin": {
    "soy": "./src/bin.js",
    "soybean": "./src/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "bin": {
      "soy": "dist/index.js",
      "soybean": "dist/index.js"
    },
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "commit": "soy git-commit",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "publish-pkg": "pnpm -r publish --access public",
    "release": "soy release",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "upkg": "soy ncu"
  },
  "dependencies": {
    "@soybeanjs/changelog": "^0.5.2",
    "bumpp": "^12.0.0",
    "c12": "^3.3.4",
    "cac": "^7.0.0",
    "consola": "^3.4.2",
    "enquirer": "^2.4.1",
    "execa": "^10.0.0",
    "kolorist": "^1.8.0",
    "npm-check-updates": "^22.2.9",
    "rimraf": "^6.1.3",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@soybeanjs/cli": "link:",
    "@soybeanjs/oxc-config": "^0.2.3",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.17.0"
}
